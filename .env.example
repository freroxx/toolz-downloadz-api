# === REQUIRED — set in Vercel Dashboard → Settings → Environment Variables ===
# Generate with: openssl rand -hex 32
API_SECRET_KEY=change_me

# === RECOMMENDED — fixes YouTube "not a bot" blocks on Vercel IPs ===
# Paste FULL content of a Netscape cookies.txt exported from a logged-in youtube.com browser.
YOUTUBE_COOKIES=

# === REQUIRED for Instagram Reels ===
# Same format, exported from a logged-in instagram.com browser.
INSTAGRAM_COOKIES=

# === HOT-RELOAD COOKIES (optional but recommended) ===
# Vercel Dashboard → Storage → Create KV (Upstash) → connect this project.
# Auto-injects these two; enables POST /api/admin/cookies refresh without redeploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === OPTIONAL tuning ===
EXTRACT_TIMEOUT=25
CACHE_TTL=3600
RATE_LIMIT=30

# === REQUIRED ===
# Security key for API authentication (X-API-KEY header). Generate: openssl rand -hex 32
API_SECRET_KEY=your_very_secure_secret_here
# Optional rotation: comma-separated additional valid keys
TRUSTED_API_KEYS=

# === OPTIONAL — YOUTUBE BYPASS ===
# Netscape-format cookies exported from a logged-in YouTube browser.
# Solves "Sign in to confirm you're not a bot" on datacenter IPs.
YOUTUBE_COOKIES=
# Or path to cookies.txt (overrides YOUTUBE_COOKIES). On Docker, mount as volume.
YT_COOKIES_FILE=
# PO Token provider (bgutil) — strongest bypass. Run alongside API:
#   docker run -d --name bgutil brainicism/bgutil-ytdlp-pot-provider
# Auto-detected on http://127.0.0.1:4416, or set custom:
YT_DLP_POT_PROVIDER_URL=
POT_PROVIDER_URL=

# === INFRA ===
# Deployment environment: production | development
ENVIRONMENT=production
# CORS: "*" or comma-separated origins (e.g. https://toolz-downloadz.vercel.app,https://yourdomain.com)
CORS_ORIGINS=*
# Cache: blank = memory, or redis://redis:6379/0
REDIS_URL=
CACHE_TTL=21600
ENABLE_CACHE=true
# Rate limits — slowapi format
RATE_LIMIT_EXTRACT=30/minute
RATE_LIMIT_DEFAULT=60/minute
LOG_LEVEL=info
SENTRY_DSN=

# === SELF-HOST ONLY ===
PORT=8000

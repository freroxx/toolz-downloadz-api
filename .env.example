# === Legacy API only — set in Vercel Dashboard → Settings → Environment Variables ===
# Generate with: openssl rand -hex 32
# v1 browser/Android clients use anonymous short-lived sessions and do not need
# this secret. Keep it while legacy /api/extract and /api/download clients exist.
API_SECRET_KEY=change_me

# === REQUIRED for Instagram Reels / Posts ===
# Paste FULL content of a Netscape cookies.txt exported from a logged-in
# instagram.com browser (extension: "Get cookies.txt LOCALLY").
# Without it most Reels fail on server IPs. TikTok needs no cookies.
INSTAGRAM_COOKIES=

# === REQUIRED for YouTube ===
# Same mechanism as Instagram, but for youtube.com: export cookies.txt from a
# browser logged into a THROWAWAY Google account (never your main account —
# automated extraction can trigger security challenges on it). This is how
# working downloaders operate (incl. cobalt's reference setup): the cookies
# carry account trust, so YouTube serves player responses even from flagged
# datacenter IPs. No PO-token server needed alongside.
# Rotate (re-export + redeploy) when YouTube extractions start failing.
YOUTUBE_COOKIES=

# === OPTIONAL tuning ===
EXTRACT_TIMEOUT=26
CACHE_TTL=3600
RATE_LIMIT=30

# === v1 production state (required for serverless durability) ===
# Create a Redis database in Upstash and copy these REST credentials. Without
# them, v1 sessions and extraction handles work only in one warm function.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GUEST_SESSION_TTL=1209600
EXTRACTION_TTL=600

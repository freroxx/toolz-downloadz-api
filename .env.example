# === REQUIRED (set in Vercel Dashboard → Settings → Environment Variables) ===
# Security key for API authentication (X-API-KEY header). Generate: openssl rand -hex 32
API_SECRET_KEY=your_very_secure_secret_here
# Optional rotation: comma-separated additional valid keys
TRUSTED_API_KEYS=

# === YOUTUBE / INSTAGRAM BYPASS (Vercel Datacenter IPs get blocked) ===
# The #1 fix on Vercel: Netscape-format cookies exported from YOUR browser (logged-in YouTube).
# Export via https://github.com/yt-dlp/yt-dlp/wiki/FAQ#how-do-i-pass-cookies-to-yt-dlp
# Paste whole cookies.txt content here. Keep it secret! Rotate after export (don't reuse that browser session).
YOUTUBE_COOKIES=
# Or store cookies as a Vercel file? On Vercel you can't mount files, so use YOUTUBE_COOKIES env above.

# Optional: External Proof-of-Origin Token server (bgutil) — only if you host it elsewhere.
# Vercel cannot run bgutil (needs Node) alongside Python, so this must be an external URL e.g. https://pot.yourdomain.com
# If left empty, the POT plugin is inactive and YouTube falls back to oEmbed on blocks.
YT_DLP_POT_PROVIDER_URL=
POT_PROVIDER_URL=

# === VERCEL CACHE (persists across serverless lambdas) ===
# By default cache is in-memory per-lambda (lost on cold start). For real persistence, connect Vercel KV / Upstash Redis:
# In Vercel: Storage → Create → KV (Upstash Redis) → Connect to project → it auto-adds KV_REST_API_URL + KV_REST_API_TOKEN.
# Or manually set UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN from Upstash console.
# If blank, cache still works but is ephemeral.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy aliases (Vercel KV uses these):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Classic Redis URL (also works if you have external Redis)
REDIS_URL=
CACHE_TTL=21600
ENABLE_CACHE=true

# === TUNING — VERCEL SERVERLESS ===
# CORS: "*" or comma-separated (e.g. https://toolz-downloadz.vercel.app,https://yourdomain.com)
CORS_ORIGINS=*
# Socket timeout capped at 12s on Vercel to stay inside function maxDuration
YTDL_SOCKET_TIMEOUT=10
# Wall timeout for extract (seconds). Vercel hobby = 10s max, so default 9s fallback keeps you safe. Pro can do 25s.
EXTRACT_TIMEOUT=25
RATE_LIMIT_EXTRACT=30/minute
RATE_LIMIT_DEFAULT=60/minute
LOG_LEVEL=info
SENTRY_DSN=

# === VERCEL AUTO (don't set manually) ===
# VERCEL=1, VERCEL_ENV=production/preview/development — detected automatically
ENVIRONMENT=production
